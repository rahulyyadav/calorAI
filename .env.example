# Local defaults. Copy to .env; never commit a real .env.

# Storage and identity
CALORAI_DB_PATH=data/calorai.sqlite3
CALORAI_USER_ID=local-demo-user
CALORAI_TIMEZONE=UTC

# Interpretation. "auto" uses the model planner only when an API key is present,
# so a clean clone keeps working with no secrets and no network.
# Options: auto | deterministic | model
CALORAI_PLANNER=auto

# Text model (any OpenAI-compatible chat-completions endpoint).
CALORAI_TEXT_MODEL=gpt-4o-mini
CALORAI_TEXT_MODEL_BASE_URL=https://api.openai.com/v1
CALORAI_TEXT_MODEL_API_KEY=
# OPENAI_API_KEY and OPENAI_MODEL are read as fallbacks.

# Vision model (any OpenAI-compatible endpoint that accepts images). Photos never go to the
# text model. Without a key here the app still runs — it says a vision model is not configured
# instead of inventing a meal. The API key falls back to the text key when it is blank.
CALORAI_VISION_MODEL=gpt-4o-mini
CALORAI_VISION_MODEL_BASE_URL=https://api.openai.com/v1
CALORAI_VISION_MODEL_API_KEY=

# Phase 5 (WhatsApp Cloud API). Every value here is a secret or an identifier from your own Meta
# app — leave them blank in a committed file and never put a real .env under version control.
# The four below must all be set, or the webhook refuses to start rather than accepting events
# it cannot prove came from Meta and then failing to answer them.
# CALORAI_WHATSAPP_VERIFY_TOKEN=
# CALORAI_WHATSAPP_APP_SECRET=
# CALORAI_WHATSAPP_ACCESS_TOKEN=
# CALORAI_WHATSAPP_PHONE_NUMBER_ID=
# Numbers allowed to talk to the agent, comma-separated wa_ids. Empty means nobody: an unlisted
# sender is refused and logged, never guessed at.
# CALORAI_WHATSAPP_ALLOWED_USERS=
# CALORAI_GRAPH_API_BASE=https://graph.facebook.com/v23.0
# Where the webhook listens. Meta reaches it through a public HTTPS tunnel (cloudflared/ngrok),
# so bind locally and let the tunnel do the exposing.
# CALORAI_WEBHOOK_HOST=127.0.0.1
# CALORAI_WEBHOOK_PORT=8080
# CALORAI_WEBHOOK_PATH=/webhook

# Phase 6 (operations). Logs carry ids, intents, models and durations — never meal text or photo
# bytes, because this is health data. The CLI stays quiet by default; the webhook raises the level
# to INFO in its own entrypoint.
CALORAI_LOG_FORMAT=text
# Options: text | json (json is what a log aggregator parses)
CALORAI_LOG_LEVEL=WARNING
# How long a model or Graph API request may take before the turn gives up on it.
CALORAI_REQUEST_TIMEOUT_SECONDS=20
# Optional LangSmith tracing. Off unless both are set: enabling tracing without a key is a
# startup failure waiting for a request, so the app declines and logs why instead.
# CALORAI_TRACING=true
# LANGCHAIN_API_KEY=
# LANGCHAIN_PROJECT=calorai
